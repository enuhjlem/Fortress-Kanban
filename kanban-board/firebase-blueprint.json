{
  "entities": {
    "board": {
      "title": "Board",
      "description": "A workspace board containing kanban tasks.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique ID of the board."
        },
        "user_id": {
          "type": "string",
          "description": "Owner UID of this board."
        },
        "name": {
          "type": "string",
          "description": "The name of the board."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        }
      },
      "required": ["id", "user_id", "name", "created_at"]
    },
    "task": {
      "title": "Task",
      "description": "A kanban task card.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique task ID."
        },
        "user_id": {
          "type": "string",
          "description": "User ID of the task owner."
        },
        "board_id": {
          "type": "string",
          "description": "ID of the board this task belongs to."
        },
        "status": {
          "type": "string",
          "enum": ["To Do", "In Progress", "Done"],
          "description": "The current status column."
        },
        "title": {
          "type": "string",
          "description": "Task title, max 100 chars."
        },
        "description": {
          "type": "string",
          "description": "Detailed task description."
        },
        "due_date": {
          "type": "string",
          "format": "date-time",
          "description": "Optional due date timestamp."
        },
        "priority_tags": {
          "type": "string",
          "enum": ["Low", "Medium", "High", "Critical"],
          "description": "Priority tag hierarchy."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        }
      },
      "required": ["id", "user_id", "board_id", "status", "title", "created_at"]
    }
  },
  "firestore": {
    "/boards/{boardId}": {
      "schema": "board",
      "description": "User boards list."
    },
    "/tasks/{taskId}": {
      "schema": "task",
      "description": "The collection of kanban tasks distributed under board IDs."
    }
  }
}
